# Generate two distinct long random strings. Never commit .env.
APP_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-different-random-string-at-least-32-characters
CRON_SECRET=replace-with-another-random-string-at-least-32-characters
PORT=3000
DATA_DIR=./data

# Required for SMS price alerts. Use E.164 phone numbers, such as +12065550123.
ALERT_PHONE=+12065550123
TWILIO_FROM=+12065550124
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: enables AI category sorting and the shopping assistant.
# Without a key, common items are sorted locally, and you can correct any category.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
