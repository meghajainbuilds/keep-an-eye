# Generate two distinct long random strings. Never commit .env.
APP_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-different-random-string-at-least-32-characters
CRON_SECRET=replace-with-another-random-string-at-least-32-characters
PORT=3000
DATA_DIR=./data

# Required for email alerts. Verify your sending domain with Resend first.
ALERT_EMAIL=you@example.com
RESEND_API_KEY=
RESEND_FROM=Shopping Watch <alerts@yourdomain.com>

# Optional: enables the shopping assistant. The key stays server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
